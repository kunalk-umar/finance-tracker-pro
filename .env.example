# Environment Variables — Finance Tracker Pro
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-change-in-production-use-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL)
DB_NAME=finance_tracker
DB_USER=finance_user
DB_PASSWORD=Finance@2024!
DB_HOST=db
DB_PORT=3306

# ML Service
ML_SERVICE_URL=http://ml_service:5001

# Email (for password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# MySQL Root (for Docker)
MYSQL_ROOT_PASSWORD=RootPass@2024!
MYSQL_DATABASE=finance_tracker
MYSQL_USER=finance_user
MYSQL_PASSWORD=Finance@2024!

